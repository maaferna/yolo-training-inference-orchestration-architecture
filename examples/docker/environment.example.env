# Environment Variables Example

# This is a template. DO NOT commit actual values to version control.
# Use proper secrets management for production deployment.

## Django Configuration

DJANGO_SECRET_KEY=PLACEHOLDER_SECRET_KEY_NEVER_COMMIT
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://[DATABASE_USER_PLACEHOLDER]:[DATABASE_PASSWORD_PLACEHOLDER]@[DATABASE_HOST_PLACEHOLDER]:5432/[DATABASE_NAME_PLACEHOLDER]
DJANGO_MEDIA_ROOT=/data/shared/
DJANGO_STATIC_ROOT=/app/static/

## FastAPI Configuration

FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
SHARED_STORAGE_PATH=/app/web_service/outputs/
YOLO_MODELS_PATH=/app/web_service/models/

## CUDA Configuration

CUDA_VISIBLE_DEVICES=0
CUDA_LAUNCH_BLOCKING=0
CUDA_DEVICE_ORDER=PCI_BUS_ID

## ClearML Configuration

CLEARML_API_HOST=PLACEHOLDER_CLEARML_HOST
CLEARML_API_ACCESS_KEY=PLACEHOLDER_API_KEY_NEVER_COMMIT
CLEARML_API_SECRET_KEY=PLACEHOLDER_SECRET_KEY_NEVER_COMMIT
CLEARML_WORKSPACE_NAME=PLACEHOLDER_WORKSPACE

## Training Configuration

YOLO_VERSION=11
DEFAULT_IMAGE_SIZE=1024
DEFAULT_BATCH_SIZE=16
DEFAULT_EPOCHS=50
NUM_TRAINING_SEEDS=5

## Inference Configuration

SAHI_TILE_SIZE=640
SAHI_OVERLAP_RATIO=0.5
INFERENCE_CONFIDENCE_THRESHOLD=0.5

## Database Configuration

POSTGRES_DB=ml_database
POSTGRES_USER=ml_user
POSTGRES_PASSWORD=PLACEHOLDER_PASSWORD_NEVER_COMMIT
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

## Logging Configuration

LOG_LEVEL=INFO
LOG_FORMAT=json

## System Configuration

TIMEZONE=UTC
WORKERS=4
